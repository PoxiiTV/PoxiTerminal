#define IDI_ICON 0x101

IDI_ICON ICON "nebula.ico"

#ifndef NEBULA_GPUI_MANIFEST
#define RT_MANIFEST 24
#define APP_MANIFEST 1

APP_MANIFEST RT_MANIFEST nebula.manifest
#endif

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Poxi"
            VALUE "FileDescription", "PoxiTerminal"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "nebula"
            VALUE "OriginalFilename", "poxiterminal.exe"
            VALUE "ProductName", "PoxiTerminal"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
